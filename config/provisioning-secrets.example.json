{
  "schema_version": 1,
  "target": {
    "address": "arcs.local",
    "port": 22,
    "username": "kratky",
    "ssh_password": "REPLACE_WITH_PI_LOGIN_PASSWORD",
    "allow_unknown_host_key": true,
    "repo_url": "https://github.com/supersiyyo/kratky_2.git",
    "repo_dir": "/home/kratky/kratky-monitor"
  },
  "system": {
    "hostname": "arcs",
    "timezone": "America/Los_Angeles",
    "desktop_autologin": true,
    "display_backend": "x11"
  },
  "tailscale": {
    "auth_key": "tskey-auth-REPLACE_WITH_ONE_OFF_PREAUTHORIZED_KEY",
    "hostname": "arcs",
    "accept_dns": true
  },
  "vnc": {
    "password": "REPLACE_WITH_DEDICATED_VNC_PASSWORD",
    "display": ":0",
    "geometry": "1920x1080",
    "port": 5900,
    "bind_to_tailscale": true
  },
  "kratky": {
    "deployment_mode": "development",
    "minimum_free_gib": 12,
    "water_camera": {
      "enabled": true,
      "required": true,
      "device": "/dev/v4l/by-id/usb-UltraSemi_Guermok_USB2_Video_20210621-video-index0"
    },
    "environment_camera": {
      "enabled": true,
      "required": true,
      "device": "/dev/v4l/by-id/usb-MACROSILICON_Guermok_USB3_Video_20210623-video-index0"
    }
  }
}
