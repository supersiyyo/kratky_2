[Unit]
Description=Kratky browser dashboard
After=kratky-capture.service
Wants=kratky-capture.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kratky
Group=kratky
WorkingDirectory=/home/kratky/kratky-monitor
Environment=KRATKY_CONFIG=/etc/kratky/config.yaml
ExecStart=/home/kratky/kratky-monitor/.venv/bin/gunicorn --workers 2 --threads 2 --bind 0.0.0.0:8080 --access-logfile - --error-logfile - app.dashboard.server:create_app()
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/kratky
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
